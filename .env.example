# Gestor Magalu — só variáveis públicas (entram no bundle do navegador).
# Nunca coloque Client Secret, service_role ou token aqui.
VITE_SUPABASE_URL=https://<SEU_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua anon key>

# Opcional: CSV de e-mails que podem entrar. Vazio = sem filtro (o Hub decide).
VITE_ALLOWED_EMAILS=

# Opcional: sem estes, o Client ID vem do Hub (Conexões) e o redirect é a origem do app.
VITE_MAGALU_CLIENT_ID=
VITE_MAGALU_REDIRECT_URI=
VITE_MAGALU_SCOPES=
